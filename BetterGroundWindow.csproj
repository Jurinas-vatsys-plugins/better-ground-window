<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>BetterGroundWindow</RootNamespace>
    <AssemblyName>BetterGroundWindow</AssemblyName>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.2.0</Version>
    <Product>Better Ground Window</Product>
    <Description>vatSys plugin: ICAO quick-jump box with history and an unlimited-zoom option for the Ground (ASMGCS) window.</Description>
    <!-- Folder containing vatSys.exe. Override with: dotnet build -p:VatSysBin="C:\Program Files (x86)\vatSys\bin" -->
    <VatSysBin Condition="'$(VatSysBin)' == ''">G:\vatSys\vatSys\bin</VatSysBin>
  </PropertyGroup>

  <ItemGroup>
    <!-- Harmony is embedded into BetterGroundWindow.dll (see below) so the plugin stays a single file. -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PkgLib_Harmony)\lib\net472\0Harmony.dll" LogicalName="BetterGroundWindow.0Harmony.dll" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="vatSys">
      <HintPath>$(VatSysBin)\vatSys.exe</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Release builds also produce dist\BetterGroundWindow-<version>.zip. Its single
    top-level BetterGroundWindow folder can be extracted into either
    <profile>\Plugins or <vatSys>\bin\Plugins (vatSys scans both recursively).
  -->
  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageStaging>$(BaseIntermediateOutputPath)package\</PackageStaging>
      <PackageZip>$(MSBuildProjectDirectory)\dist\BetterGroundWindow-$(Version).zip</PackageZip>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStaging)" />
    <Copy SourceFiles="$(TargetPath);README.md;Install-BetterGroundWindow.ps1" DestinationFolder="$(PackageStaging)BetterGroundWindow" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\dist" />
    <ZipDirectory SourceDirectory="$(PackageStaging)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Release package: $(PackageZip)" />
  </Target>

</Project>
